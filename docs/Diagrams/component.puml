
@startuml component-diagram
!theme plain
skinparam componentStyle rectangle
skinparam nodesep 60
skinparam ranksep 80
<style>
component {
  Padding 6
}
</style>
skinparam ArrowFontSize 11

title Tolksyn – Component Diagram

actor "Staff / Admin" as User

package "Mobile App (Expo / React Native)" {

  package "UI / Screens" {
    together {
      [Capture Screen] as CaptureScreen
      [Confirm & Edit Screen] as ConfirmScreen
    }
    together {
      [History Screen] as HistoryScreen
      [Settings Screen] as SettingsScreen
    }
  }

  package "Services" {
    together {
      [Capture Pipeline] as CapturePipeline
      [Remote Extractor] as RemoteExtractor
    }
    together {
      [Submission Service] as SubmissionService
      [Queue Worker] as QueueWorker
    }
    [Barcode Detector] as BarcodeDetector
  }

  package "Repositories & Persistence" {
    together {
      [Attempt Repository] as AttemptRepo
      [Queue Repository] as QueueRepo
    }
    together {
      [Image Store] as ImageStore
      [SQLite / Drizzle] as Database
    }
    [Secure Store] as SecureStore
    [Settings Repository] as SettingsRepo
  }

  package "Platform Bridges" {
    [Camera & Image Picker] as DeviceMedia
    [File System] as Filesystem
  }
}

cloud "External Services" {
  [AI Provider APIs\n(OpenAI, Google, etc.)] as RemoteVLEndpoint
  [Ingest Endpoint\n(Configured API)] as IngestEndpoint
}

' ── User interactions ─────────────────────────────────────
User --> CaptureScreen : Capture/Select
User --> ConfirmScreen : Review/Edit
User --> HistoryScreen : View attempts
User --> SettingsScreen : Configure providers

' ── UI to Services ────────────────────────────────────────
CaptureScreen  --> CapturePipeline
CaptureScreen  --> DeviceMedia
ConfirmScreen  --> SubmissionService
HistoryScreen  --> AttemptRepo
SettingsScreen --> SettingsRepo

' ── Service orchestrations ────────────────────────────────
CapturePipeline --> BarcodeDetector
CapturePipeline --> RemoteExtractor
CapturePipeline --> AttemptRepo
CapturePipeline --> ImageStore

SubmissionService --> IngestEndpoint : Online
SubmissionService --> QueueRepo : Offline
QueueWorker --> QueueRepo
QueueWorker --> IngestEndpoint

RemoteExtractor --> RemoteVLEndpoint : HTTPS

' ── Persistence layer ─────────────────────────────────────
AttemptRepo --> Database
QueueRepo --> Database
SettingsRepo --> SecureStore
ImageStore --> Filesystem

@enduml
