@startuml app-state-machine-v2
hide empty description

[*] --> Capture

state Capture {
  [*] --> Idle
  Idle --> Camera : Take Photo
  Idle --> Gallery : Select Image
  Camera --> ImageAcquired
  Gallery --> ImageAcquired
}

Capture --> Preprocess : ImageAcquired

state Processing {
  [*] --> ParallelExtract

  state "Parallel Extraction" as ParallelExtract {
    state "Barcode Detection" as Barcode
    [*] --> Barcode
    Barcode --> [*]
    
    --
    
    state "VL Extraction" as VLExtract {
      [*] --> CatalogCheck
      CatalogCheck --> RemoteVL : image-capable model
      RemoteVL --> [*] : Success
      RemoteVL --> VLError : Timeout/Fail
      VLError --> [*]
    }
  }
  
  ParallelExtract --> MergeResults
  MergeResults --> Validation
  Validation --> [*]
}

Processing --> Confirm : Valid JSON Output
Processing --> ExtractError : Validation or Extraction Error

ExtractError --> Processing : User Retries
ExtractError --> Capture : User Cancels

state Confirm {
  [*] --> ReviewData
  ReviewData --> EditData : User Edits
  EditData --> ReviewData : Save Edits
}

Confirm --> Sending : User Accepts
Confirm --> Processing : User Retries Extraction
Confirm --> Capture : User Denies / Discards

state Sending {
  state network <<choice>>
  [*] --> network
  network --> IngestAPI : Device Online
  network --> OfflineQueue : Device Offline
  
  IngestAPI --> [*] : 2xx Success
  IngestAPI --> OfflineQueue : Network Unavailable
  OfflineQueue --> [*] : Queued for later
}

Sending --> Capture : Data Sent / Queued Successfully
Sending --> SendError : Fatal Error (e.g. 4xx/5xx)

SendError --> Sending : User Retries
SendError --> Confirm : Back to Edit

@enduml
