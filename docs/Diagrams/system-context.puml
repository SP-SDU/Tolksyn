@startuml system-context
!theme plain
title Tolksyn - System Context

actor "Registration staff" as Staff
rectangle "Tolksyn app\nExpo / React Native" as App
database "Local SQLite\nattempts + queue" as LocalDb
cloud "Configured VL provider\nOpenAI / Google / Anthropic / Copilot" as Provider
cloud "Configured ingest endpoint\nMock or future production API" as Ingest

Staff --> App : Capture/import label\nReview and accept JSON
App --> LocalDb : Store image metadata,\ndraft, history, queue
App --> Provider : HTTPS image-to-JSON\nwhen remote extraction is used
App --> Ingest : HTTPS POST reviewed payload\nor queue when unavailable
@enduml
